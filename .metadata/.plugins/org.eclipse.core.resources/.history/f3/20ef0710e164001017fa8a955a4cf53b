#include "main.h"

void delay(volatile uint32_t time) {
    while(time--);
}

int main(void) {
    // 1. RCC saatini aktif et (GPIOA için)
    RCC->APB2ENR |= (1 << 2);  // Bit 2: IOPAEN

    // 2. GPIOA pin 5'i Output Push-Pull olarak ayarla (max speed 2MHz)
    // CRL → pin 0-7 için
    // MODE5[1:0] = 10 (Output mode, max speed 2 MHz)
    // CNF5[1:0]  = 00 (General purpose output push-pull)

    GPIOA->CRL &= ~(0xF << (5 * 4));      // Önce temizle
    GPIOA->CRL |=  (0x2 << (5 * 4));      // 0b0010 → MODE=10, CNF=00

    while (1) {
        // 3. PA5 HIGH yap (LED ON)
        GPIOA->BSRR = (1 << 5);

        delay(100000);

        // 4. PA5 LOW yap (LED OFF)
        GPIOA->BRR = (1 << 5);

        delay(100000);
    }
}
