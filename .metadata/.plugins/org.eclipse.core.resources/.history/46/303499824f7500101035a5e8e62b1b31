	// 1. Clock Enable (TIM2 + GPIO)
	RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;   // TIM2 clock enable
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;  // GPIOA clock enable

	// 2. GPIO PA5 çıkış modunda ayarla (LED bağlıysa)
	GPIOA->MODER &= ~(0x3 << (7 * 2));
	GPIOA->MODER |=  (0x1 << (7 * 2));  // Output mode

	// 3. Timer ayarları
	TIM2->PSC = 16000 - 1;   // 16 MHz / 16000 = 1 kHz (1ms)
	TIM2->ARR = 1000 - 1;    // 1ms * 1000 = 1 saniye
	TIM2->CNT = 0;           // Sayacı sıfırla
	TIM2->CR1 |= TIM_CR1_CEN;  // Timer'ı başlat

	while (1)
	{
	    // 4. Zaman doldu mu kontrol et
	    if (TIM2->SR & TIM_SR_UIF)
	    {
	        TIM2->SR &= ~TIM_SR_UIF;  // Flag'i temizle

	        // 5. LED toggle
	        GPIOA->ODR ^= (1 << 7);
	    }
	}
}
