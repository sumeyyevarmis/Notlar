#include "stm32f10x.h"

void GPIO_Config(void);
void TIM2_PWM_Config(void);

int main(void)
{
    GPIO_Config();
    TIM2_PWM_Config();

    while (1)
    {
        // Örnek: LED parlaklığını artırma ve azaltma
        for (int duty = 0; duty <= 999; duty++) {
            TIM2->CCR1 = duty;
            for (volatile int i = 0; i < 1000; i++); // küçük delay
        }
        for (int duty = 999; duty >= 0; duty--) {
            TIM2->CCR1 = duty;
            for (volatile int i = 0; i < 1000; i++); // küçük delay
        }
    }
}

void GPIO_Config(void)
{
    // GPIOA saatini aç
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;

    // PA0 -> Alternate Function Push-Pull (PWM çıkışı)
    GPIOA->CRL &= ~(GPIO_CRL_MODE0 | GPIO_CRL_CNF0);
    GPIOA->CRL |= GPIO_CRL_MODE0_1;   // Output 2 MHz
    GPIOA->CRL |= GPIO_CRL_CNF0_1;    // AF Push-Pull
}

void TIM2_PWM_Config(void)
{
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN; // TIM2 saatini aç

    TIM2->PSC = 8000 - 1;   // 8 MHz / 8000 = 1 kHz
    TIM2->ARR = 1000 - 1;   // 1 kHz / 1000 = 1 Hz (1 saniyede 1 PWM periyodu)

    TIM2->CCR1 = 500;       // Başlangıç duty cycle %50

    TIM2->CCMR1 |= (6 << TIM_CCMR1_OC1M_Pos); // PWM mode 1
    TIM2->CCMR1 |= TIM_CCMR1_OC1PE;           // Preload enable
    TIM2->CCER |= TIM_CCER_CC1E;              // CH1 enable

    TIM2->CR1 |= TIM_CR1_CEN; // Timer başlat
}
