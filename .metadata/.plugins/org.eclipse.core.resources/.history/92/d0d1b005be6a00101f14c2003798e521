#include "main.h"
void delay(volatile uint32_t time) {
    while(time--);
}

int main(){

	// GPIOB clock enable
	RCC->APB2ENR |= (1 << 3);

	// GPIOB Port 3 Output
	GPIOB->CRL &= ~(0xF << 12);
	GPIOB->CRL |= (0b0010 << 12);

	while(1){
		GPIOB->BSRR |= (1 << 3);
		delay(100000);
		GPIOB->BRR |= (1 << 3);
		delay(100000);
	}
}
