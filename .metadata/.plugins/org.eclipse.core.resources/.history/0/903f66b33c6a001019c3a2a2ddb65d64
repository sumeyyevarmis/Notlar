#include "main.h"

void EXTI_IRQHandler(void){
	// Interrupt flag temizle
	EXTI->PR |= (1 << 5); //

	// Led toggle
	GPIOA->ODR ^= (1 << 7);
}

int main()
{
	// 1. RCC Enable (GPIOA ve AFIO)
	RCC->APB2ENR |= (1 << 2); // GPIOA
	RCC->APB2ENR |= (1 << 0); // AFIO

	// 2. PA5 -> input pull-up
	GPIOA->CRL &= ~(0xF << 20); // PA5 konfigürasyonları temizlenir
	GPIOA->CRL |= (0b1000 << 20); // PA5 input, pull-up olarak tanımlanır.
	GPIOA->ODR |= (1 << 20); // Pull-up, butona basıınca 0 olacak

	// 3. PA7 outout push-pull
	GPIOA->CRL &= ~(0xF << 28); // PA7 için konfigürasyonu temizle
	GPIOA->CRL |= (0b0010); // PA7 output, push-pull, 2 MHz

	// 4. EXTI ayarları (EXTI5 için PA5)
	AFIO->EXTICR[1] &= ~(0xF << 4); // EXTI5 için PA5 seçilir

	EXTI->IMR |= (1 << 5); // Interrupt mask aktif
	EXTI->FTSR |= (1 << 5); // Falling edge trigger aktif

	// 5. NVIC ayarları
	NVIC_EnableIRQ(EXTI5_IRQn);
}
