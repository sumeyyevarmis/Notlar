#include "main.h"
void delay(volatile uint32_t time) {
    while(time--);
}

void EXTI9_5_IRQHandler(void){
	if(EXTI->PR & (1 << 7)){
		EXTI->PR |= (1 << 7);
		// LED on
		GPIOB->BSRR |= (1 << 1);
		GPIOB->BRR |= (1 << 0);
	}
}

int main(){

	// GPIOB clock enable
	RCC->APB2ENR |= (1 << 3);
	// GPIOA clock enable
	RCC->APB2ENR |= (1 << 2);
	// AFIO clock enable
	RCC->APB2ENR |= (1 << 0);

	/* OUTPUT */
	// GPIOB Port 1 Output
	GPIOB->CRL &= ~(0xF << 4);
	GPIOB->CRL |= (0b0010 << 4);

	// GPIOB Port 0 Output
	GPIOB->CRL &= ~(0xF << 0);
	GPIOB->CRL |= (0b0010 << 0);

	/* INPUT */
	// PA7 input
	GPIOA->CRL &= ~(0xF << 28);
	GPIOA->CRL |= (0b1000 << 28);
	GPIOA->ODR |= (1 << 7);


	/* EXTI */
	AFIO->EXTICR[1] &= ~(0xF << 12);
	EXTI->IMR |= (1 << 7);
	EXTI->FTSR |= (1 << 7);


	/* NVIC */
	NVIC_EnableIRQ(EXTI9_5_IRQn);

	while(1){

	}
}
