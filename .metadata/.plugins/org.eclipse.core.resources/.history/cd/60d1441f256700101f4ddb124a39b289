#include "main.h"

int main(){

	RCC->APB2ENR = (1 << 2);

	GPIOA->CRL &= ~(0xF << 28); // PA7
	GPIOA->CRL &= ~(0xF << 20); // PA5

	GPIOA->CRL |= (0b0010 << 28); // Output
	GPIOA->CRL |= (0b1000 << 20); // input

	GPIOA->ODR |= (1 << 5); // input high, yani normalde 1 oldu

	while(1){
		// butona basilirsa PA5 = 0 olacak
		if(!(GPIOA->IDR & (1 << 5))){
			GIOPA->BSRR |= (1 << 7); // led on
		}
		else{
			GPIOA->BRR |= (1 << 7); // len off
		}
	}
}
